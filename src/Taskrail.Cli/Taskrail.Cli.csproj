<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>taskrail</AssemblyName>
    <RootNamespace>Taskrail.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- single-file publish settings; RID is supplied by the release workflow -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Taskrail.Runtime\Taskrail.Runtime.csproj" />
    <ProjectReference Include="..\Taskrail.Llm\Taskrail.Llm.csproj" />
    <ProjectReference Include="..\Taskrail.Bench\Taskrail.Bench.csproj" />
    <PackageReference Include="Spectre.Console.Cli" />
    <InternalsVisibleTo Include="Taskrail.E2E.Tests" />
  </ItemGroup>
</Project>
