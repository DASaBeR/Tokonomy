@@ -26,6 +26,44 @@ class CartTests(unittest.TestCase):
         cart.add("book", 20.00)
         self.assertEqual(cart.total({"type": "fixed", "value": 5}), 15.0)
 
+    def test_items_store_cents(self):
+        cart = Cart()
+        cart.add("pen", 19.99, 3)
+        self.assertEqual(cart.items[0], {"sku": "pen", "unit_price_cents": 1999, "qty": 3})
+
+    def test_subtotal_cents_exact(self):
+        cart = Cart()
+        cart.add("a", 0.1)
+        cart.add("b", 0.2)
+        self.assertEqual(cart.subtotal_cents(), 30)
+        self.assertEqual(cart.subtotal(), 0.3)
+        self.assertIsInstance(cart.subtotal_cents(), int)
+
+    def test_sale_rounds_whole_line_once(self):
+        cart = Cart(on_sale=True)
+        cart.add("x", 0.03, 3)
+        self.assertEqual(cart.subtotal_cents(), 7)
+        self.assertEqual(cart.line_total(cart.items[0]), 0.07)
+
+    def test_sale_rounds_half_up(self):
+        cart_y = Cart(on_sale=True)
+        cart_y.add("y", 0.07, 1)
+        self.assertEqual(cart_y.subtotal_cents(), 6)
+
+        cart_z = Cart(on_sale=True)
+        cart_z.add("z", 0.03, 1)
+        self.assertEqual(cart_z.subtotal_cents(), 2)
+
+    def test_empty_cart(self):
+        cart = Cart()
+        self.assertEqual(cart.subtotal_cents(), 0)
+        self.assertEqual(cart.subtotal(), 0.0)
+
+    def test_line_total_dollars(self):
+        cart = Cart()
+        cart.add("pen", 2.50, 4)
+        self.assertEqual(cart.line_total(cart.items[0]), 10.0)
+
 
 if __name__ == "__main__":
     unittest.main()
