diff --git a/shop/pricing.py b/shop/pricing.py
index 7fc9613..52df880 100644
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -22,3 +22,28 @@ def apply_coupon(amount: float, coupon):
     if coupon["type"] == "fixed":
         return round2(amount - coupon["value"])
     raise ValueError(f"unknown coupon type: {coupon['type']}")
+
+
+def apply_coupons(amount: float, coupons) -> float:
+    """Apply several coupons to an amount.
+
+    Rules:
+    - At most one percent coupon applies, the one with the highest value.
+    - The percent coupon applies first, then fixed coupons in order.
+    - Result is never below 0.0.
+    - Unknown coupon types raise ValueError.
+    - Input list and coupons are not mutated.
+    """
+    if coupons is None:
+        coupons = []
+    for coupon in coupons:
+        if coupon["type"] not in ("percent", "fixed"):
+            raise ValueError(f"unknown coupon type: {coupon['type']}")
+    percents = [c for c in coupons if c["type"] == "percent"]
+    fixeds = [c for c in coupons if c["type"] == "fixed"]
+    if percents:
+        amount = apply_coupon(amount, max(percents, key=lambda c: c["value"]))
+    for coupon in fixeds:
+        amount = apply_coupon(amount, coupon)
+    return max(0.0, amount)
+
