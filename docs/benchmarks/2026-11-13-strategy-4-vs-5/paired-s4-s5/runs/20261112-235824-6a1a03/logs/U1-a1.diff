+from shop.pricing import apply_coupon, apply_coupons, sale_price
 
 
 class PricingTests(unittest.TestCase):
@@ -21,6 +21,43 @@ class PricingTests(unittest.TestCase):
         self.assertEqual(round2(1.005), 1.01)
         self.assertEqual(fmt(1234.5), "$1,234.50")
 
+    def test_apply_coupons_none_and_empty(self):
+        self.assertEqual(apply_coupons(100.0, None), 100.0)
+        self.assertEqual(apply_coupons(100.0, []), 100.0)
+
+    def test_apply_coupons_percent_before_fixed(self):
+        coupons = [{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]
+        self.assertEqual(apply_coupons(100.0, coupons), 85.0)
+
+    def test_apply_coupons_best_percent_only(self):
+        coupons = [
+            {"type": "percent", "value": 10},
+            {"type": "percent", "value": 30},
+            {"type": "percent", "value": 20},
+        ]
+        self.assertEqual(apply_coupons(100.0, coupons), 70.0)
+
+    def test_apply_coupons_fixed_in_order(self):
+        coupons = [{"type": "fixed", "value": 5}, {"type": "fixed", "value": 3}]
+        self.assertEqual(apply_coupons(100.0, coupons), 92.0)
+
+    def test_apply_coupons_floor_zero(self):
+        coupons = [{"type": "fixed", "value": 150}]
+        self.assertEqual(apply_coupons(100.0, coupons), 0.0)
+
+    def test_apply_coupons_unknown_type(self):
+        coupons = [{"type": "fixed", "value": 1}, {"type": "bogus"}]
+        with self.assertRaisesRegex(ValueError, "unknown coupon type: bogus"):
+            apply_coupons(100.0, coupons)
+
+    def test_apply_coupons_does_not_mutate(self):
+        coupons = [{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]
+        original = [dict(c) for c in coupons]
+        apply_coupons(100.0, coupons)
+        self.assertEqual(coupons, original)
+        for i, c in enumerate(coupons):
+            self.assertEqual(c, original[i])
+
 
 if __name__ == "__main__":
     unittest.main()
