     def subtotal(self) -> float:
         return round2(sum(self.line_total(item) for item in self.items))
 
-    def total(self, coupon=None) -> float:
-        return apply_coupon(self.subtotal(), coupon)
+    def total(self, coupons=None) -> float:
+        if not self.items:
+            return 0.0
+        if coupons is None:
+            coupons = []
+        elif isinstance(coupons, dict):
+            coupons = [coupons]
+        return apply_coupons(self.subtotal(), coupons)
diff --git a/tests/test_cart.py b/tests/test_cart.py
index 7da09ad..d370f71 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,3 +1,4 @@
+import copy
 import unittest
 
 from shop.cart import Cart
@@ -26,6 +27,45 @@ class CartTests(unittest.TestCase):
         cart.add("book", 20.00)
         self.assertEqual(cart.total({"type": "fixed", "value": 5}), 15.0)
 
+    def test_multiple_coupons(self):
+        cart = Cart()
+        cart.add("book", 100.0)
+        coupons = [{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]
+        self.assertEqual(cart.total(coupons), 85.0)
+
+    def test_only_best_percent(self):
+        cart = Cart()
+        cart.add("book", 100.0)
+        coupons = [{"type": "percent", "value": 10}, {"type": "percent", "value": 25}]
+        self.assertEqual(cart.total(coupons), 75.0)
+
+    def test_total_never_negative(self):
+        cart = Cart()
+        cart.add("book", 10.0)
+        coupons = [{"type": "fixed", "value": 15}]
+        self.assertEqual(cart.total(coupons), 0.0)
+
+    def test_empty_cart_is_zero(self):
+        cart = Cart()
+        coupons = [{"type": "percent", "value": 10}, {"type": "fixed", "value": 5}]
+        self.assertEqual(cart.total(coupons), 0.0)
+        self.assertEqual(cart.total(), 0.0)
+
+    def test_unknown_coupon_type_raises(self):
+        cart = Cart()
+        cart.add("book", 100.0)
+        coupons = [{"type": "bogus", "value": 10}]
+        with self.assertRaisesRegex(ValueError, "unknown coupon type: bogus"):
+            cart.total(coupons)
+
+    def test_coupons_list_not_mutated(self):
+        cart = Cart()
+        cart.add("book", 100.0)
+        coupons = [{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]
+        snapshot = copy.deepcopy(coupons)
+        cart.total(coupons)
+        self.assertEqual(coupons, snapshot)
+
 
 if __name__ == "__main__":
     unittest.main()
