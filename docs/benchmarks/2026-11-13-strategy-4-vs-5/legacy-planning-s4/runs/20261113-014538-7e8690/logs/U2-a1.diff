+"""In-memory TTL cache with optional LRU size limit."""
+
+import threading
+import time
+
+from shop.lru import LRU
+
+_MISSING = object()
+
+
+class TtlCache:
+    """A thread-safe in-memory cache with per-item TTL and optional LRU eviction."""
+
+    def __init__(
+        self,
+        ttl_seconds: float,
+        max_size: int | None = None,
+        clock=time.monotonic,
+    ):
+        """Initialize a new TtlCache.
+
+        Args:
+            ttl_seconds: Lifetime in seconds for cache entries.
+            max_size: Maximum entries before evicting, or None for unlimited.
+            clock: Monotonic time callable, defaults to time.monotonic.
+        """
+        if max_size is not None and max_size < 1:
+            raise ValueError("max_size must be at least 1")
+        self._ttl = ttl_seconds
+        self._max_size = max_size
+        self._clock = clock
+        self._lru = LRU()
+        self._lock = threading.RLock()
+
+    def _expired(self, stored_at: float, now: float) -> bool:
+        """Return True if an entry stored at stored_at is expired at now."""
+        return now - stored_at >= self._ttl
+
+    def _purge(self, now: float) -> None:
+        """Purge all expired entries from the cache."""
+        for key in self._lru.keys():
+            entry = self._lru.peek(key, _MISSING)
+            if entry is not _MISSING:
+                _, stored_at = entry
+                if self._expired(stored_at, now):
+                    self._lru.remove(key)
+
+    def set(self, key, value) -> None:
+        """Store key with value, resetting its TTL to now."""
+        with self._lock:
+            now = self._clock()
+            if key in self._lru:
+                self._lru.put(key, (value, now))
+                return
+            if self._max_size is not None and len(self._lru) >= self._max_size:
+                self._purge(now)
+                if len(self._lru) >= self._max_size:
+                    self._lru.pop_lru()
+            self._lru.put(key, (value, now))
+
+    def get(self, key, default=None):
+        """Return value for key if present and live, otherwise default."""
+        with self._lock:
+            now = self._clock()
+            entry = self._lru.peek(key, _MISSING)
+            if entry is _MISSING:
+                return default
+            value, stored_at = entry
+            if self._expired(stored_at, now):
+                self._lru.remove(key)
+                return default
+            val, _ = self._lru.get(key)
+            return val
+
+    def delete(self, key) -> bool:
+        """Remove key from the cache. Return True if live, False otherwise."""
+        with self._lock:
+            now = self._clock()
+            entry = self._lru.peek(key, _MISSING)
+            if entry is _MISSING:
+                return False
+            _, stored_at = entry
+            if self._expired(stored_at, now):
+                self._lru.remove(key)
+                return False
+            self._lru.remove(key)
+            return True
+
+    def __contains__(self, key) -> bool:
+        """Return True only for a live entry."""
+        with self._lock:
+            now = self._clock()
+            entry = self._lru.peek(key, _MISSING)
+            if entry is _MISSING:
+                return False
+            _, stored_at = entry
+            if self._expired(stored_at, now):
+                self._lru.remove(key)
+                return False
+            return True
+
+    def __len__(self) -> int:
+        """Return the count of live entries in the cache."""
+        with self._lock:
+            now = self._clock()
+            self._purge(now)
+            return len(self._lru)
diff --git a/tests/test_cache.py b/tests/test_cache.py
