+++ b/tests/test_cache.py
@@ -0,0 +1,289 @@
+import threading
+import time
+import unittest
+
+from shop.cache import TtlCache
+
+
+class FakeClock:
+    """A fake clock with a mutable t attribute."""
+
+    def __init__(self, initial: float = 0.0):
+        self.t = initial
+
+    def __call__(self) -> float:
+        return self.t
+
+    def advance(self, delta: float) -> None:
+        self.t += delta
+
+
+class TtlCacheTests(unittest.TestCase):
+    def test_set_and_get(self):
+        clock = FakeClock()
+        cache = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache.set("a", 1)
+        cache.set("b", 2)
+        self.assertEqual(cache.get("a"), 1)
+        self.assertEqual(cache.get("b"), 2)
+        self.assertEqual(len(cache), 2)
+        self.assertIn("a", cache)
+        self.assertIn("b", cache)
+
+    def test_missing_key_returns_default(self):
+        clock = FakeClock()
+        cache = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache.set("a", 1)
+        self.assertIsNone(cache.get("missing"))
+        self.assertEqual(cache.get("missing", "fallback"), "fallback")
+        self.assertEqual(cache.get("missing", 42), 42)
+
+    def test_ttl_expiry_exact(self):
+        clock = FakeClock(100.0)
+        cache = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache.set("k", "v")
+
+        # Live at ttl - epsilon
+        clock.t = 109.999
+        self.assertEqual(cache.get("k"), "v")
+        self.assertIn("k", cache)
+        self.assertEqual(len(cache), 1)
+
+        # Gone exactly at ttl (clock() - stored_at == ttl_seconds)
+        clock.t = 110.0
+        self.assertIsNone(cache.get("k"))
+        self.assertNotIn("k", cache)
+        self.assertEqual(len(cache), 0)
+
+    def test_set_on_existing_key_restarts_ttl(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache.set("a", 1)
+
+        clock.t = 6.0
+        cache.set("a", 2)
+
+        clock.t = 12.0
+        self.assertEqual(cache.get("a"), 2)
+        self.assertIn("a", cache)
+        self.assertEqual(len(cache), 1)
+
+        clock.t = 16.0
+        self.assertIsNone(cache.get("a"))
+        self.assertNotIn("a", cache)
+        self.assertEqual(len(cache), 0)
+
+    def test_set_on_expired_key_restarts_ttl(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=5.0, clock=clock)
+        cache.set("a", 1)
+
+        clock.t = 10.0
+        cache.set("a", 2)
+        self.assertEqual(cache.get("a"), 2)
+        self.assertIn("a", cache)
+        self.assertEqual(len(cache), 1)
+
+    def test_get_does_not_extend_ttl(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache.set("a", 1)
+
+        clock.t = 5.0
+        self.assertEqual(cache.get("a"), 1)
+
+        clock.t = 8.0
+        self.assertEqual(cache.get("a"), 1)
+
+        clock.t = 10.0
+        self.assertIsNone(cache.get("a"))
+        self.assertNotIn("a", cache)
+        self.assertEqual(len(cache), 0)
+
+    def test_len_and_in_ignore_expired_entries(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=5.0, clock=clock)
+        cache.set("a", 1)
+
+        clock.t = 3.0
+        cache.set("b", 2)
+
+        clock.t = 5.0
+        self.assertNotIn("a", cache)
+        self.assertIn("b", cache)
+        self.assertEqual(len(cache), 1)
+
+        clock.t = 8.0
+        self.assertNotIn("b", cache)
+        self.assertEqual(len(cache), 0)
+
+    def test_none_is_a_real_value(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache.set("k", None)
+
+        self.assertIn("k", cache)
+        self.assertEqual(len(cache), 1)
+        self.assertIsNone(cache.get("k", "fallback"))
+
+        clock.t = 10.0
+        self.assertEqual(cache.get("k", "fallback"), "fallback")
+        self.assertNotIn("k", cache)
+        self.assertEqual(len(cache), 0)
+
+    def test_delete_return_values(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache.set("live", 1)
+        cache.set("exp", 2)
+
+        self.assertFalse(cache.delete("missing"))
+
+        clock.t = 10.0
+        self.assertFalse(cache.delete("exp"))
+        self.assertNotIn("exp", cache)
+
+        cache.set("fresh", 3)
+        self.assertTrue(cache.delete("fresh"))
+        self.assertFalse(cache.delete("fresh"))
+        self.assertNotIn("fresh", cache)
+
+    def test_eviction_lru_with_get(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=100.0, max_size=2, clock=clock)
+        cache.set("a", 1)
+        cache.set("b", 2)
+        self.assertEqual(cache.get("a"), 1)
+        cache.set("c", 3)
+
+        self.assertIsNone(cache.get("b"))
+        self.assertNotIn("b", cache)
+        self.assertEqual(cache.get("a"), 1)
+        self.assertEqual(cache.get("c"), 3)
+        self.assertEqual(len(cache), 2)
+
+    def test_eviction_set_counts_as_use(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=100.0, max_size=2, clock=clock)
+        cache.set("a", 1)
+        cache.set("b", 2)
+        cache.set("a", 10)
+        cache.set("c", 3)
+
+        self.assertIsNone(cache.get("b"))
+        self.assertNotIn("b", cache)
+        self.assertEqual(cache.get("a"), 10)
+        self.assertEqual(cache.get("c"), 3)
+        self.assertEqual(len(cache), 2)
+
+    def test_expired_entries_dropped_before_evicting_live_one(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=10.0, max_size=2, clock=clock)
+        cache.set("a", 1)
+
+        clock.t = 10.0
+        cache.set("b", 2)
+        cache.set("c", 3)
+
+        self.assertNotIn("a", cache)
+        self.assertIn("b", cache)
+        self.assertIn("c", cache)
+        self.assertEqual(cache.get("b"), 2)
+        self.assertEqual(cache.get("c"), 3)
+        self.assertEqual(len(cache), 2)
+
+    def test_updating_existing_key_in_full_cache_evicts_nothing(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=100.0, max_size=2, clock=clock)
+        cache.set("a", 1)
+        cache.set("b", 2)
+
+        cache.set("a", 10)
+        self.assertEqual(len(cache), 2)
+        self.assertIn("a", cache)
+        self.assertIn("b", cache)
+        self.assertEqual(cache.get("a"), 10)
+        self.assertEqual(cache.get("b"), 2)
+
+    def test_value_error_for_invalid_max_size(self):
+        with self.assertRaises(ValueError):
+            TtlCache(ttl_seconds=10.0, max_size=0)
+        with self.assertRaises(ValueError):
+            TtlCache(ttl_seconds=10.0, max_size=-1)
+
+        cache_none = TtlCache(ttl_seconds=10.0, max_size=None)
+        cache_one = TtlCache(ttl_seconds=10.0, max_size=1)
+        self.assertIsNotNone(cache_none)
+        self.assertIsNotNone(cache_one)
+
+    def test_two_instances_are_independent(self):
+        clock = FakeClock(0.0)
+        cache1 = TtlCache(ttl_seconds=10.0, clock=clock)
+        cache2 = TtlCache(ttl_seconds=10.0, clock=clock)
+
+        cache1.set("k", "v1")
+        self.assertIn("k", cache1)
+        self.assertNotIn("k", cache2)
+        self.assertEqual(len(cache1), 1)
+        self.assertEqual(len(cache2), 0)
+
+        cache2.set("k", "v2")
+        self.assertEqual(cache1.get("k"), "v1")
+        self.assertEqual(cache2.get("k"), "v2")
+
+        cache1.delete("k")
+        self.assertNotIn("k", cache1)
+        self.assertIn("k", cache2)
+        self.assertEqual(cache2.get("k"), "v2")
+
+    def test_contains_does_not_change_recency(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=100.0, max_size=2, clock=clock)
+        cache.set("a", 1)
+        cache.set("b", 2)
+        self.assertTrue("a" in cache)
+        cache.set("c", 3)
+        self.assertNotIn("a", cache)
+        self.assertIn("b", cache)
+        self.assertIn("c", cache)
+
+    def test_thread_safety(self):
+        clock = FakeClock(0.0)
+        cache = TtlCache(ttl_seconds=50.0, max_size=50, clock=clock)
+        errors = []
+
+        def worker(tid: int):
+            try:
+                for i in range(1000):
+                    key = f"key_{(i + tid) % 80}"
+                    op = i % 3
+                    if op == 0:
+                        cache.set(key, i)
+                    elif op == 1:
+                        cache.get(key)
+                    else:
+                        cache.delete(key)
+            except Exception as exc:
+                errors.append(exc)
+
+        threads = [threading.Thread(target=worker, args=(i,)) for i in range(8)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(errors, [])
+        self.assertLessEqual(len(cache), 50)
+
+    def test_default_clock_monotonic(self):
+        cache = TtlCache(ttl_seconds=10.0)
+        self.assertIs(cache._clock, time.monotonic)
+        cache.set("x", 42)
+        self.assertEqual(cache.get("x"), 42)
+        self.assertIn("x", cache)
+        self.assertEqual(len(cache), 1)
+        self.assertTrue(cache.delete("x"))
+
+
+if __name__ == "__main__":
+    unittest.main()
