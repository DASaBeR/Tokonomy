+        self.assertNotIn("unit_price", cart.items[0])
+        self.assertIsInstance(cart.items[0]["unit_price_cents"], int)
+
+    def test_exact_sum_without_float_drift(self):
+        cart = Cart()
+        cart.add("a", 0.1)
+        cart.add("b", 0.1)
+        cart.add("c", 0.1)
+        self.assertEqual(cart.subtotal_cents(), 30)
