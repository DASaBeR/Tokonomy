+"""Money helpers. Amounts are dollars as floats or integer cents."""
+
+from decimal import Decimal, ROUND_HALF_UP
+
+
+def to_cents(amount: float) -> int:
+    """Convert dollars to integer cents, rounding half up."""
+    return int((Decimal(repr(amount)) * 100).quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+
+
+def from_cents(cents: int) -> float:
+    """Convert integer cents to float dollars."""
+    return cents / 100
 
 
