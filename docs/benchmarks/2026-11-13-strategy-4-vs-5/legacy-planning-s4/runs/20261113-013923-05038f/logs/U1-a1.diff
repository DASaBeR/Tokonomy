@@ -0,0 +1,26 @@
+import unittest
+
+from shop.money import from_cents, to_cents
+
+
+class MoneyTests(unittest.TestCase):
+    def test_to_cents(self):
+        self.assertEqual(to_cents(19.99), 1999)
+        self.assertEqual(to_cents(0.1 + 0.2), 30)
+        self.assertEqual(to_cents(1.005), 101)
+        self.assertEqual(to_cents(0.0), 0)
+        self.assertEqual(to_cents(12.0), 1200)
+        self.assertIsInstance(to_cents(19.99), int)
+
+    def test_from_cents(self):
+        self.assertEqual(from_cents(1999), 19.99)
+        self.assertEqual(from_cents(0), 0.0)
+        self.assertIsInstance(from_cents(1999), float)
+
+    def test_round_trip(self):
+        for x in (19.99, 0.3, 2.5):
+            self.assertEqual(from_cents(to_cents(x)), x)
+
+
+if __name__ == "__main__":
+    unittest.main()
