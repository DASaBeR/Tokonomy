+    def test_apply_coupons_combinations(self):
+        self.assertEqual(
+            apply_coupons(100.0, [{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]),
+            85.0,
+        )
+        self.assertEqual(
+            apply_coupons(
+                100.0,
+                [
+                    {"type": "percent", "value": 10},
+                    {"type": "percent", "value": 25},
+                    {"type": "fixed", "value": 5},
+                ],
+            ),
+            70.0,
+        )
+        self.assertEqual(
+            apply_coupons(100.0, [{"type": "fixed", "value": 3}, {"type": "fixed", "value": 2}]),
+            95.0,
+        )
+        self.assertEqual(
+            apply_coupons(10.0, [{"type": "fixed", "value": 50}]),
+            0.0,
+        )
+        self.assertEqual(apply_coupons(100.0, None), 100.0)
+        self.assertEqual(apply_coupons(100.0, []), 100.0)
+
+    def test_apply_coupons_unknown_type(self):
+        bogus_coupon = {"type": "bogus", "value": 1}
+        with self.assertRaises(ValueError) as cm_single:
+            apply_coupon(100.0, bogus_coupon)
+
+        coupons = [{"type": "fixed", "value": 5}, bogus_coupon]
+        with self.assertRaises(ValueError) as cm_multi:
+            apply_coupons(100.0, coupons)
+
+        self.assertEqual(str(cm_multi.exception), str(cm_single.exception))
+        self.assertEqual(str(cm_multi.exception), "unknown coupon type: bogus")
+
+    def test_apply_coupons_does_not_mutate_input(self):
+        coupons = [
+            {"type": "fixed", "value": 5},
+            {"type": "percent", "value": 10},
+            {"type": "percent", "value": 25},
+        ]
+        original = copy.deepcopy(coupons)
+        result = apply_coupons(100.0, coupons)
+        self.assertEqual(result, 70.0)
+        self.assertEqual(coupons, original)
+
+    def test_apply_coupons_tie_percent(self):
+        coupons = [
+            {"type": "percent", "value": 20, "order": 1},
+            {"type": "percent", "value": 20, "order": 2},
+        ]
+        self.assertEqual(apply_coupons(100.0, coupons), 80.0)
+
+    def test_apply_coupons_single_dict(self):
