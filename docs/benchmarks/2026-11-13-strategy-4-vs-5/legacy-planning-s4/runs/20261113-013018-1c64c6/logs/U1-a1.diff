diff --git a/shop/pricing.py b/shop/pricing.py
index 7fc9613..3552dbe 100644
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -22,3 +22,34 @@ def apply_coupon(amount: float, coupon):
     if coupon["type"] == "fixed":
         return round2(amount - coupon["value"])
     raise ValueError(f"unknown coupon type: {coupon['type']}")
+
+
+def apply_coupons(amount: float, coupons=None) -> float:
+    """Apply coupons to an amount.
+
+    At most one percent coupon (highest value) applies first,
+    then each fixed coupon in order.
+    """
+    if not coupons:
+        return amount
+    if isinstance(coupons, dict):
+        coupons = [coupons]
+
+    coupon_list = list(coupons)
+
+    for coupon in coupon_list:
+        if coupon.get("type") not in ("percent", "fixed"):
+            apply_coupon(amount, coupon)
+
+    percent_coupons = [c for c in coupon_list if c["type"] == "percent"]
+    result = amount
+    if percent_coupons:
+        best_percent = max(percent_coupons, key=lambda c: c["value"])
+        result = apply_coupon(result, best_percent)
+
+    for coupon in coupon_list:
+        if coupon["type"] == "fixed":
+            result = apply_coupon(result, coupon)
+
+    return round2(max(0.0, result))
+
