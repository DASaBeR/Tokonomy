 """A shopping cart."""
 
 from shop.money import round2
-from shop.pricing import apply_coupon, sale_price
+from shop.pricing import apply_coupons, sale_price
 
 
 class Cart:
@@ -19,5 +19,13 @@ class Cart:
     def subtotal(self) -> float:
         return round2(sum(self.line_total(item) for item in self.items))
 
-    def total(self, coupon=None) -> float:
-        return apply_coupon(self.subtotal(), coupon)
+    def total(self, coupons=None) -> float:
+        if not self.items:
+            return 0.0
+        if coupons is None:
+            normalized = []
+        elif isinstance(coupons, dict):
+            normalized = [coupons]
+        else:
+            normalized = list(coupons)
+        return apply_coupons(self.subtotal(), normalized)
diff --git a/tests/test_cart.py b/tests/test_cart.py
index 7da09ad..7151467 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,3 +1,4 @@
+import copy
 import unittest
 
 from shop.cart import Cart
@@ -26,6 +27,76 @@ class CartTests(unittest.TestCase):
         cart.add("book", 20.00)
         self.assertEqual(cart.total({"type": "fixed", "value": 5}), 15.0)
 
+    def test_empty_cart_with_coupons(self):
+        cart = Cart()
+        self.assertEqual(cart.total(), 0.0)
+        self.assertEqual(cart.total(None), 0.0)
+        self.assertEqual(cart.total({"type": "fixed", "value": 5}), 0.0)
+        self.assertEqual(cart.total([{"type": "fixed", "value": 5}]), 0.0)
+        self.assertEqual(
+            cart.total([{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]),
+            0.0,
+        )
+
+    def test_subtotal_100_with_fixed_and_percent(self):
+        cart = Cart()
+        cart.add("item", 100.00)
+        self.assertEqual(
+            cart.total([{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]),
+            85.0,
+        )
+
+    def test_two_percent_coupons_apply_highest(self):
+        cart = Cart()
+        cart.add("item", 100.00)
+        self.assertEqual(
+            cart.total([{"type": "percent", "value": 10}, {"type": "percent", "value": 25}]),
+            75.0,
+        )
+        self.assertEqual(
+            cart.total([{"type": "percent", "value": 25}, {"type": "percent", "value": 10}]),
+            75.0,
+        )
+
+    def test_fixed_coupons_applied_after_percent_regardless_of_order(self):
+        cart = Cart()
+        cart.add("item", 100.00)
+        self.assertEqual(
+            cart.total([{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]),
+            85.0,
+        )
+        self.assertEqual(
+            cart.total([{"type": "percent", "value": 10}, {"type": "fixed", "value": 5}]),
+            85.0,
+        )
+
+    def test_single_dict_coupon(self):
+        cart = Cart()
+        cart.add("item", 100.00)
+        self.assertEqual(cart.total({"type": "percent", "value": 10}), 90.0)
+        self.assertEqual(cart.total({"type": "fixed", "value": 5}), 95.0)
+
+    def test_fixed_coupon_larger_than_subtotal(self):
+        cart = Cart()
+        cart.add("item", 20.00)
+        self.assertEqual(cart.total({"type": "fixed", "value": 50}), 0.0)
+        self.assertEqual(cart.total([{"type": "fixed", "value": 50}]), 0.0)
+
+    def test_unknown_type_in_list_raises_value_error(self):
+        cart = Cart()
+        cart.add("item", 100.00)
+        with self.assertRaises(ValueError):
+            cart.total([{"type": "fixed", "value": 5}, {"type": "bogus", "value": 1}])
+
+    def test_coupons_list_unchanged(self):
+        cart = Cart()
+        cart.add("item", 100.00)
+        coupons = [{"type": "fixed", "value": 5}, {"type": "percent", "value": 10}]
+        original = copy.deepcopy(coupons)
+        result = cart.total(coupons)
+        self.assertEqual(result, 85.0)
+        self.assertEqual(coupons, original)
+
 
 if __name__ == "__main__":
     unittest.main()
