<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Version>0.0.1</Version>
    <DebugType>embedded</DebugType>
    <Authors>Tokonomy contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DASaBeR/Tokonomy</RepositoryUrl>
    <!-- CA1848/CA1873: LoggerMessage delegates; CA2007: ConfigureAwait in a CLI app; CA1303: localization -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1303;CA1515;CA1031;CA1062;CA1716;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304</NoWarn>
  </PropertyGroup>
</Project>
